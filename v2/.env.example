PORT=4180
HOST=127.0.0.1
DATABASE_PATH=./data/booking.sqlite
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-different-long-random-secret
NOTIFICATION_WEBHOOK_URL=

# Ставить 1 только если сервер стоит за обратным прокси, который сам
# подставляет X-Forwarded-For. Иначе ограничение попыток входа обходится
# подстановкой этого заголовка.
TRUST_PROXY=0

# Второй рубеж распознавания кризиса: локальная модель через Ollama.
# Без этих переменных работают только списки шаблонов, а они не обобщаются
# на незнакомые формулировки (docs/crisis-detection-limits.md).
OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen3:8b
