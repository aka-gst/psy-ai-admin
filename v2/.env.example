PORT=4180
HOST=127.0.0.1
DATABASE_PATH=./data/booking.sqlite
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-different-long-random-secret
NOTIFICATION_WEBHOOK_URL=

# В production за https://aka-gst.ru/psy-admin/booking/ cookie остаётся
# внутри приложения записи, а не распространяется на весь сайт.
COOKIE_PATH=/psy-admin/booking/

# Ставить 1 только если сервер стоит за обратным прокси, который сам
# подставляет X-Forwarded-For. Иначе ограничение попыток входа обходится
# подстановкой этого заголовка.
TRUST_PROXY=0

# Мозг помощника: распознавание кризиса и выбор темы.
# Без LLM_BASE_URL работают только списки шаблонов, а они не обобщаются на
# незнакомые формулировки (docs/crisis-detection-limits.md).
# Адрес, оканчивающийся на /v1, читается как OpenAI-совместимый; иначе как
# нативный Ollama. Переопределяется LLM_TRANSPORT=openai|ollama.
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=local
LLM_MODEL=qwen3:8b
